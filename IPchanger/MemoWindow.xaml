<Window x:Class="IPchanger.MemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPchanger"
        Title="{Binding Path=[MemoTitle], Source={x:Static local:LanguageManager.Instance}}" Height="{Binding Source={x:Static properties:Settings.Default}, Path=MemoHeight, Mode=TwoWay}"
        Width="{Binding Source={x:Static properties:Settings.Default}, Path=MemoWidth, Mode=TwoWay}"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        xmlns:properties="clr-namespace:IPchanger.Properties"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="10">
        <TextBox x:Name="txtMemo" 
                 Style="{StaticResource ModernTextBox}" 
                 AcceptsReturn="True" 
                 AcceptsTab="True" 
                 TextWrapping="Wrap" 
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Source={x:Static properties:Settings.Default}, Path=MemoContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</Window>