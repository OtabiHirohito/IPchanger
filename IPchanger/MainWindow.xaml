<Window x:Class="IPchanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPchanger"
        xmlns:properties="clr-namespace:IPchanger.Properties"
        Title="{Binding Path=[AppTitle], Source={x:Static local:LanguageManager.Instance}}"
        MinWidth="600" MinHeight="450"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,12">
            <DockPanel>
                <TextBlock Text="{Binding Path=[AppTitle], Source={x:Static local:LanguageManager.Instance}}" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="chkLanguage" Content="{Binding Path=[EngLabel], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding IsEnglishMode, Source={x:Static properties:Settings.Default}}" Click="chkLanguage_Click" Style="{StaticResource HeaderToggleButton}" FontSize="12" Margin="0,0,20,0"/>
                    <ToggleButton x:Name="chkGwMode" Content="{Binding Path=[AdvancedSettings], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding IsGatewayMode, Source={x:Static properties:Settings.Default}}" Click="chkGwMode_Click" Style="{StaticResource HeaderToggleButton}" FontSize="12" Margin="0,0,20,0"/>
                    <ToggleButton x:Name="btnMemo" Content="{Binding Path=[ShowMemo], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding IsMemoOpen, Source={x:Static properties:Settings.Default}}" Click="btnMemo_Click" Style="{StaticResource HeaderToggleButton}" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,10">
            <StackPanel>
                <!-- Adapter Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Title and Current IP (Span both columns so IP doesn't affect the boundary below) -->
                        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Path=[AdapterSelection], Source={x:Static local:LanguageManager.Instance}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblCurrentIp" Foreground="{StaticResource PrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/>
                        </DockPanel>

                        <!-- Row 1: ComboBox and Refresh Button (ComboBox expands to hit the button) -->
                        <ComboBox Grid.Row="1" Grid.Column="0" x:Name="cmbAdapters" SelectionChanged="cmbAdapters_SelectionChanged" Height="32" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
                        <Button Grid.Row="1" Grid.Column="1" x:Name="btnRefresh" Content="{Binding Path=[Refresh], Source={x:Static local:LanguageManager.Instance}}" Click="btnRefresh_Click" Style="{StaticResource SecondaryButton}" Width="80" Height="32" Margin="10,0,0,0" ToolTip="{Binding Path=[RefreshToolTip], Source={x:Static local:LanguageManager.Instance}}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Patterns Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,5">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="5,0,5,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="colHeaderGw" Width="*"/>
                                <ColumnDefinition x:Name="colHeaderDns" Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Path=[IpAddress], Source={x:Static local:LanguageManager.Instance}}" Foreground="#666" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Path=[SubnetMask], Source={x:Static local:LanguageManager.Instance}}" Foreground="#666" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtHeaderGw" Grid.Column="2" Text="{Binding Path=[Gateway], Source={x:Static local:LanguageManager.Instance}}" Foreground="#666" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtHeaderDns" Grid.Column="3" Text="{Binding Path=[Dns], Source={x:Static local:LanguageManager.Instance}}" Foreground="#666" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Grid>

                        <StackPanel x:Name="pnlPatterns">
                            <!-- Pattern 1 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="colBoxGw1" Width="*"/>
                                    <ColumnDefinition x:Name="colBoxDns1" Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="txtIp1" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged" Tag="IP1"/>
                                <TextBox Grid.Column="1" x:Name="txtSub1" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged" Tag="Sub1"/>
                                <TextBox Grid.Column="2" x:Name="txtGw1" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged" Tag="GW1"/>
                                <TextBox Grid.Column="3" x:Name="txtDns1" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged" Tag="DNS1"/>
                                <Button Grid.Column="4" Content="{Binding Path=[Apply1], Source={x:Static local:LanguageManager.Instance}}" Click="btnApply1_Click" Style="{StaticResource ModernButton}" Height="30" Margin="5,0,2,0"/>
                            </Grid>

                            <!-- Pattern 2 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="colBoxGw2" Width="*"/>
                                    <ColumnDefinition x:Name="colBoxDns2" Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="txtIp2" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <TextBox Grid.Column="1" x:Name="txtSub2" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <TextBox Grid.Column="2" x:Name="txtGw2" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <TextBox Grid.Column="3" x:Name="txtDns2" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <Button Grid.Column="4" Content="{Binding Path=[Apply2], Source={x:Static local:LanguageManager.Instance}}" Click="btnApply2_Click" Style="{StaticResource ModernButton}" Height="30" Margin="5,0,2,0"/>
                            </Grid>

                            <!-- Pattern 3 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="colBoxGw3" Width="*"/>
                                    <ColumnDefinition x:Name="colBoxDns3" Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="txtIp3" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <TextBox Grid.Column="1" x:Name="txtSub3" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <TextBox Grid.Column="2" x:Name="txtGw3" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <TextBox Grid.Column="3" x:Name="txtDns3" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <Button Grid.Column="4" Content="{Binding Path=[Apply3], Source={x:Static local:LanguageManager.Instance}}" Click="btnApply3_Click" Style="{StaticResource ModernButton}" Height="30" Margin="5,0,2,0"/>
                            </Grid>

                            <!-- Pattern 4 -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="colBoxGw4" Width="*"/>
                                    <ColumnDefinition x:Name="colBoxDns4" Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="txtIp4" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <TextBox Grid.Column="1" x:Name="txtSub4" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <TextBox Grid.Column="2" x:Name="txtGw4" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <TextBox Grid.Column="3" x:Name="txtDns4" Style="{StaticResource ModernTextBox}" Margin="2,0" TextChanged="txt_TextChanged"/>
                                <Button Grid.Column="4" Content="{Binding Path=[Apply4], Source={x:Static local:LanguageManager.Instance}}" Click="btnApply4_Click" Style="{StaticResource ModernButton}" Height="30" Margin="5,0,2,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" Grid.Column="0" Text="{Binding Path=[Ready], Source={x:Static local:LanguageManager.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#666" FontSize="12"/>
                <Button x:Name="btnSetDhcp" Grid.Column="1" Content="{Binding Path=[SetDhcp], Source={x:Static local:LanguageManager.Instance}}" Click="btnSetDhcp_Click" Style="{StaticResource ModernButton}" Background="#0067C0" Width="200" Height="36"/>
            </Grid>
        </Border>
    </Grid>
</Window>