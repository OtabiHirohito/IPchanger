<Window x:Class="IPchanger.PingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPchanger"
        xmlns:properties="clr-namespace:IPchanger.Properties"
        Title="{Binding Path=[PingToolTitle], Source={x:Static local:LanguageManager.Instance}}"
        Height="{Binding Source={x:Static properties:Settings.Default}, Path=PingHeight, Mode=TwoWay}"
        Width="{Binding Source={x:Static properties:Settings.Default}, Path=PingWidth, Mode=TwoWay}"
        MinHeight="300" MinWidth="400"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Input and Action Row -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="{Binding Path=[TargetIpLabel], Source={x:Static local:LanguageManager.Instance}}"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="btnPing"
                            Content="{Binding Path=[PingExecute], Source={x:Static local:LanguageManager.Instance}}"
                            Click="btnPing_Click"
                            Style="{StaticResource ModernButton}"
                            Height="32" Padding="12,4" Margin="0,0,8,0"/>
                    <Button x:Name="btnIpconfig"
                            Content="{Binding Path=[IpconfigExecute], Source={x:Static local:LanguageManager.Instance}}"
                            Click="btnIpconfig_Click"
                            Style="{StaticResource SecondaryButton}"
                            Height="32" Padding="12,4"/>
                </StackPanel>
                <TextBox x:Name="txtTargetIp"
                         Style="{StaticResource ModernTextBox}"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         Text="{Binding Source={x:Static properties:Settings.Default}, Path=PingTargetIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Border>

        <!-- Output Display Area -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="txtResult"
                     Style="{StaticResource ModernTextBox}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Courier New, Monospace"
                     FontSize="12"
                     Background="#1E1E1E"
                     Foreground="#D4D4D4"
                     BorderThickness="0"
                     Padding="10"/>
        </Border>
    </Grid>
</Window>
